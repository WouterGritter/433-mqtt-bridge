MQTT_BROKER_ADDRESS=mqtt-broker.local
DISCORD_WEBHOOK_URL=https://my.discord.webhook.url/

# Public base URL of the web interface (behind your reverse proxy), used for Discord claim links.
BASE_URL=https://433-bridge.example.com
# WEB_HOST=0.0.0.0
# WEB_PORT=8000

# Where reading history for the dashboard is stored (SQLite), and how long to keep it.
# STATS_DB_PATH=stats.db
# STATS_RETENTION_DAYS=30

# Ping-pong / id-collision monitor: alerts when an id-bearing sensor's readings alternate
# between two value levels (two sensors sharing the same random id). Defaults shown.
# MONITOR_ENABLED=true
# MONITOR_WINDOW_SECONDS=900
# MONITOR_MIN_SAMPLES=8
# MONITOR_MIN_AMPLITUDE=1.0
# MONITOR_SEPARATION_RATIO=3.0
# MONITOR_RUNS_Z=2.0
# MONITOR_COOLDOWN_SECONDS=21600
